{
  "name": "front-end",
  "version": "1.0.0",
  "description": "Frontend SPA for RIWI integrator project platform",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "vite",
    "lint": "node scripts/check-js.mjs lint && eslint src/react --ext .ts,.tsx",
    "format": "prettier --check \"src/react/**/*.{ts,tsx,css,md}\" \"src/utils/spreadsheetSecurity*.js\" \"docs/**/*.md\" \"*.{json,js,ts}\"",
    "format:write": "prettier --write \"src/react/**/*.{ts,tsx,css,md}\" \"src/utils/spreadsheetSecurity*.js\" \"docs/**/*.md\" \"*.{json,js,ts}\"",
    "type-check": "node scripts/check-js.mjs type-check && tsc --noEmit",
    "test": "node scripts/state_container.test.js && node scripts/api_fetch.test.js && vitest run && node scripts/smoke-e2e.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "npm run lint && npm run format && npm run type-check && npm test && npm run build"
  },
  "dependencies": {
    "i18next": "^25.8.17",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
